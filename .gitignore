# ============================================================
# Experiment outputs — selective
# ============================================================
# Commit: CSV results and summary PNGs referenced in README
# Ignore: intermediate artifacts, per-run dumps, large logs

results/*.log
results/*.json
results/tmp/
results/runs/
results/*_raw.csv
results/*_debug.*

